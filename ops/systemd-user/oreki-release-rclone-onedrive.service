[Unit]
Description=AD-Oreki release one-way copy to OneDrive
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/Releases/AD-Oreki-Edition/latest/反物质维度.apk

[Service]
Type=oneshot
EnvironmentFile=%h/.config/oreki-release.env
ExecStart=/usr/bin/rclone copyto ${AD_RELEASE_APK} ${AD_ONEDRIVE_REMOTE}:${AD_ONEDRIVE_DIR}/反物质维度.apk --retries 3 --low-level-retries 10 --log-level INFO
