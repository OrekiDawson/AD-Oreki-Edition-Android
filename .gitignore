# ============================================================
#  反物质维度 Oreki Edition —— Git 忽略规则
#  原则：
#    1. 可重新生成的大体积产物不入库（work/ tools/ *.apk）
#    2. 源码、脚本、payload、报告、验收证据一律入库
#    3. 密钥与口令绝不入库
# ============================================================

# ---------- 1. 构建中间树（apktool 解码/重建，约 1.7G、11 万文件）----------
# base_decoded/base_rebuild/mod/verify/out 等全部由 scripts/build_mod.py
# 从 input_info/input_file.txt 记录的原始 XAPK 重新生成，属于一次性中间物。
/work/

# ---------- 2. 构建工具链（第三方二进制，约 719M）----------
# jdk/ jdk17.zip bt/ buildtools.zip platform-tools/ apktool.jar 等。
# 需要时按 tools/README.md 重新放置；只有 README 入库。
/tools/*
!/tools/README.md

# ---------- 3. APK / 签名板产物（单件约 66.5MB，可由 build_mod.py 重新生成）----------
# 覆盖 release/反物质维度.apk、build/*.apk、build/backup*/*.apk
*.apk
*.apks
*.xapk
*.idsig

# ---------- 4. build/ 内的可重建中间物与临时目录 ----------
/build/dexcheck/
/build/out/

# ---------- 4b. Gradle（R4）----------
# Gradle 自己的缓存、暂存产物与报告都可重建；build.gradle / wrapper / gradlew 要入库。
/.gradle/
/build/gradle-stage/
/build/gradle-reports/
/build/gradle-verify-apk/

# ---------- 5. 签名密钥与口令（绝不入库）----------
/keys/
*.jks
*.keystore
*.p12
*.pfx
*.pk8
密码.txt
*.pass
.secrets*

# 该文件是 row18 改动前的 build_mod.py 备份，内含明文签名口令，
# 只在本地留存追溯，不入库（脚本本身已由 Git 版本化）。
/build/backup_pre_row18/build_mod.py.bak

# ---------- 6. Python 缓存 ----------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# ---------- 7. IDE / 编辑器个人配置 ----------
.idea/
.vscode/
*.iml
*.swp
*~

# ---------- 8. 系统杂项与临时文件 ----------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.orig
*.rej

# ---------- 9. 反编译碎片 / 临时取证物（可由 REA 或 build_mod.py 重新生成）----------
# *.raw 是 jadx / baksmali 的中间导出；analysis/ 是逐轮分析的临时目录；
# build/_*.png 是装机验证的临时截图（正式验收截图放 docs/ 或 handoff/）。
*.raw
/analysis/
/_r*/
# build/ 下以 _ 开头的都是逐轮临时物（build.log 仍入库）
build/_*

# ---------- release/：手工放置的发布候补 APK（单件约 66MB）----------
# 构建产物由 scripts/build_mod.py 重新生成；发布副本走 OneDrive/小米云盘，不入库。
/release/

# ---------- build/：构建中间树与临时日志（含超长路径的 smali 解码产物）----------
# 与 /work/ 同类：可由 scripts/build_mod.py 重新生成。R40 实测 build/tutorial_check
# 下的解码树有路径超过 Windows 260 字符上限，git add 直接 fatal。
/build/

# ---------- 10. smali 自检的编译/汇编产物（reports/r40b/_check）----------
# 这三类都是「跑一次就变」的二进制或临时输入，入库只会制造无法评审的脏 diff：
#   · *.dex  —— SmaliCheck <in.smali> <out.dex> 的输出，每次自检都重写
#   · *.class —— javac 编译 SmaliCheck.java 的产物（.java 是源码，必须入库）
#   · l3fix/  —— ach_audit.py 离线分支测试的一次性日志样例（几行文本，全文抄在 chore(repo) 提交信息里）
# 需要复核时按 reports/r40b/_check/README 或 scripts/ach_audit.py 顶部注释重建。
reports/r40b/_check/*.dex
reports/r40b/_check/*.class
reports/r40b/_check/l3fix/

# 探针临时状态（每次运行重写，不入库）
reports/**/tmp/
