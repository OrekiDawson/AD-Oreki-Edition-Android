# Linux APK 四渠道发布配置模板。复制到 shell 环境或 ~/.config/oreki-release.env，
# 不要把真实 OAuth 信息、cookie、token、密码或 SSH 私钥写入仓库。

# 本地 SSH/SFTP 交付目录（默认：~/Releases/AD-Oreki-Edition）
AD_RELEASE_DIR="$HOME/Releases/AD-Oreki-Edition"

# rclone remote 名称与固定目录；remote 必须先通过 `rclone config` 完成 OAuth。
AD_ONEDRIVE_REMOTE="onedrive"
AD_ONEDRIVE_DIR="Apps/AD-Oreki-Edition"
AD_GDRIVE_REMOTE="gdrive"
AD_GDRIVE_DIR="AD-Oreki-Edition"

# 可选；不设置时从当前 Android 仓库 origin 解析。
AD_GITHUB_REPO="OrekiDawson/AD-Oreki-Edition-Android"
