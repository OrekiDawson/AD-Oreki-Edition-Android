.method public static a()Lye;
    .locals 6

    .line 1
    const-string/jumbo v0, "uniform shader content;\nuniform float2 direction;\nuniform float sigma;\n\nvoid tapPair(int k, float2 coord, float twoSigma2, inout half4 sum, inout float weightSum) {\n    float a = float(2 * k - 1);\n    float b = a + 1.0;\n    float wa = exp(-a * a / twoSigma2);\n    float wb = exp(-b * b / twoSigma2);\n    float w = wa + wb;\n    float2 offset = direction * (a + wb / max(w, 1e-6));\n    sum += (content.eval(coord + offset) + content.eval(coord - offset)) * half(w);\n    weightSum += 2.0 * w;\n}\n\nhalf4 main(float2 coord) {\n    float twoSigma2 = 2.0 * sigma * sigma;\n    half4 sum = content.eval(coord);\n    float weightSum = 1.0;\n    if (sigma < 2.6) {\n        for (int k = 1; k <= 4; k++) tapPair(k, coord, twoSigma2, sum, weightSum);\n    } else if (sigma < 5.3) {\n        for (int k = 1; k <= 8; k++) tapPair(k, coord, twoSigma2, sum, weightSum);\n    } else {\n        for (int k = 1; k <= 16; k++) tapPair(k, coord, twoSigma2, sum, weightSum);\n    }\n    return sum / half(weightSum);\n}"

