 bounds="[60,2454][1380,2702]"><node index="0" text="保存间隔" resource-id="" class="android.widget.Button" package="com.oreki.antimatterdimensions" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[100,2494][408,2662]" /><node index="1" text="恢复默认 3 秒" resource-id="" class="android.widget.Button" package="com.oreki.antimatterdimensions" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[408,2494][789,2662]" /></node><node index="12" text="严格模式：任意两次自动操作之间都必须 ≥ 间隔&#10;（连原版等价的连续购买也一起被限制，会显著变慢甚至停滞。默认关闭。）" resource-id="" class="android.widget.CheckBox" package="com.oreki.antimatterdimensions" content-desc="" checkable="true" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,2702][1380,2995]" /><node index="13" text="调度说明：间隔约束的是「策略决策周期」——现实 / 天神 / Perk / 终局 / Break 升级 / 闸门这些离散决策，多久重新评估一次。买反物质维度、计数频率、维度提升、星系、献祭、重开、无限维度、无限升级、时间研究这些属于原版自动购买器的职责，默认按原版 tick 节奏跑，不受此间隔限制（用户令第 8 条：不得破坏原版机制）；只有勾选严格模式才会把它们一起纳入。同一帧最多只放行一个真动作；没有真正改变游戏状态的调用不计入间隔、立即让位给下一个候选；失败的调用有 2 秒独立冷却，不会无限重试。" resource-id="" class="android.widget.TextView" package="com.oreki.antimatterdimensions" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,2995][1380,3032]" /></node></node></node></node><node index="1" text="" resource-id="android:id/statusBarBackground" class="android.view.View" package="com.oreki.antimatterdimensions" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="fal